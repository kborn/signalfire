NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
# portfolio (default) exposes the Admin entry point (footer link, demo banner CTA,
# /demo credentials section); demo hides it. Independent of NEXT_PUBLIC_ENABLE_DEMO_MODE,
# which only controls the "sample data" banner.
NEXT_PUBLIC_SITE_MODE=portfolio
